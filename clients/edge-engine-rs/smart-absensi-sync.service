[Unit]
Description=Smart Absensi Edge Sync Daemon (Rust)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
NotifyAccess=main
User=edge
Group=edge
WorkingDirectory=/opt/smart-absensi/edge-engine
ExecStart=/usr/local/bin/smart-absensi-sync --db /data/absensi.db
Restart=always
RestartSec=5
WatchdogSec=60
EnvironmentFile=/data/config/.env

# Security Hardening & Sandboxing for Read-Only RootFS
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data /tmp

[Install]
WantedBy=multi-user.target
