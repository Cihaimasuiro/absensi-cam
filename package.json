{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build":     "vite build",
        "dev":       "concurrently -c \"cyan,magenta,yellow\" -n \"LARAVEL,VITE,EDGE\" \"php artisan serve\" \"node node_modules/vite/bin/vite.js\" \"node scripts/run-edge.mjs\"",
        "dev:web":   "concurrently -c \"cyan,magenta\" -n \"LARAVEL,VITE\" \"php artisan serve\" \"node node_modules/vite/bin/vite.js\"",
        "dev:edge":  "node scripts/run-edge.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "alpinejs": "^3.17.4"
    }
}
