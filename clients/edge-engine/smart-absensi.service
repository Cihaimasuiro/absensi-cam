[Unit]
Description=Absensi Cam Edge Engine
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=edge
Group=edge
WorkingDirectory=/opt/smart-absensi/edge-engine
Environment="PATH=/opt/smart-absensi/edge-engine/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/smart-absensi/edge-engine/venv/bin/python engine.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=smart-absensi

[Install]
WantedBy=multi-user.target
