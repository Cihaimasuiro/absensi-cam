{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Absensi-Cam",
  "version": "0.1.0",
  "identifier": "com.absensicam.desktop",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Absensi-Cam · Admin Shell",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
