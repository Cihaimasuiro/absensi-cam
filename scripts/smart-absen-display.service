# /etc/systemd/system/smart-absen-display.service
# Install: sudo cp scripts/smart-absen-display.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now smart-absen-display

[Unit]
Description=Smart Absen — Arduino TFT Display Bridge
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smart-absen
ExecStart=/usr/bin/python3 /opt/smart-absen/scripts/display_service.py --port /dev/ttyACM0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
