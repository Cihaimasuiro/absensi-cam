[Unit]
Description=Smart Absensi Edge Sync Daemon (Rust)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=edge
Group=edge
WorkingDirectory=/opt/smart-absensi/edge-engine
ExecStart=/usr/local/bin/smart-absensi-sync --db /opt/smart-absensi/edge-engine/local_edge.db
Restart=always
RestartSec=5
WatchdogSec=60
EnvironmentFile=/opt/smart-absensi/edge-engine/.env

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/smart-absensi/edge-engine

[Install]
WantedBy=multi-user.target
